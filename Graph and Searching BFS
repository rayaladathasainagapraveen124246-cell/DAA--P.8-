#include <iostream>
#include <queue>
using namespace std;

int graph[10][10];
int visited[10];
int n;

// BFS function
void BFS(int start)
{
    queue<int> q;

    visited[start] = 1;
    q.push(start);

    while (!q.empty())
    {
        int vertex = q.front();
        q.pop();

        cout << vertex << " ";

        // Visit all adjacent vertices
        for (int i = 0; i < n; i++)
        {
            if (graph[vertex][i] == 1 && visited[i] == 0)
            {
                visited[i] = 1;
                q.push(i);
            }
        }
    }
}

int main()
{
    int edges, u, v, start;

    cout << "Enter number of vertices: ";
    cin >> n;

    // Initialize graph
    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            graph[i][j] = 0;
        }
    }

    cout << "Enter number of edges: ";
    cin >> edges;

    cout << "Enter edges (u v):" << endl;

    for (int i = 0; i < edges; i++)
    {
        cin >> u >> v;

        graph[u][v] = 1;
        graph[v][u] = 1;   // Undirected graph
    }

    cout << "Enter starting vertex: ";
    cin >> start;

    // Initialize visited array
    for (int i = 0; i < n; i++)
    {
        visited[i] = 0;
    }

    cout << "BFS Traversal: ";
    BFS(start);

    return 0;
}

INPUT:
Enter number of vertices: 5
Enter number of edges: 5
Enter edges (u v):
0 1
0 2
1 3
1 4
2 4
Enter starting vertex: 0

OUTPUT:
BFS Traversal: 0 1 2 3 4

